#!/bin/sh
set -e
cd "$(git rev-parse --show-toplevel)"

FORBIDDEN=$(
  git diff --cached --name-only --diff-filter=ACM \
    | grep -E '(^|/)target/|^\.idea/|^\.cursor/|^\.vscode/|\.DS_Store$|\.iml$|(^|/)surefire-reports/|(^|/)out/|(^|/)build/' \
    || true
)

if [ -n "$FORBIDDEN" ]; then
  echo "Commit blocked: do not commit build artifacts or IDE metadata:"
  echo "$FORBIDDEN"
  echo "Run: git restore --staged <path>  (and ensure paths are listed in .gitignore)"
  exit 1
fi

./mvnw -q -pl pk-quality test
