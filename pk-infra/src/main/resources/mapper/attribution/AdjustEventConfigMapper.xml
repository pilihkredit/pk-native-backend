<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pk.infra.attribution.mapper.AdjustEventConfigMapper">
    <resultMap id="adjustEventConfigMap" type="com.pk.core.attribution.port.AdjustEventConfigRepository$AdjustEventConfigData">
        <constructor>
            <arg column="id" javaType="_long"/>
            <arg column="event_name" javaType="string"/>
            <arg column="app_token" javaType="string"/>
            <arg column="is_enabled" javaType="_boolean"/>
        </constructor>
    </resultMap>

    <select id="findEnabledByEventNameAndAppToken" resultMap="adjustEventConfigMap">
        SELECT id, event_name, app_token, is_enabled
        FROM adjust_event_config
        WHERE event_name = #{eventName}
          AND app_token = #{appToken}
          AND is_enabled = 1
        LIMIT 1
    </select>
</mapper>
