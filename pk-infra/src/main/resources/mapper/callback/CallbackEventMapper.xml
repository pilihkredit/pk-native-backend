<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pk.infra.callback.mapper.CallbackEventMapper">
<resultMap id="callbackRecordMap" type="com.pk.core.callback.port.CallbackEventRepository$CallbackEventRecord">
<constructor><arg column="id" javaType="long"/><arg column="callback_no" javaType="string"/>
<arg column="provider_code" javaType="string"/><arg column="callback_type" javaType="string"/>
<arg column="business_id" javaType="string"/><arg column="idempotency_key" javaType="string"/>
<arg column="external_status" javaType="string"/><arg column="payload_json" javaType="string"/>
<arg column="process_status" javaType="string"/></constructor></resultMap>
<insert id="insert">INSERT INTO callback_event (callback_no,provider_code,callback_type,business_id,idempotency_key,external_status,payload_json,process_status,received_at)
VALUES (#{callbackNo},#{providerCode},#{callbackType},#{businessId},#{idempotencyKey},#{externalStatus},#{payloadJson},#{processStatus},#{receivedAt,typeHandler=com.pk.infra.mybatis.typehandler.InstantTypeHandler})</insert>
<select id="findIdByCallbackNo" resultType="long">SELECT id FROM callback_event WHERE callback_no=#{callbackNo}</select>
<select id="findById" resultMap="callbackRecordMap">SELECT id,callback_no,provider_code,callback_type,business_id,idempotency_key,external_status,payload_json,process_status FROM callback_event WHERE id=#{id}</select>
<select id="findByIdempotencyKey" resultMap="callbackRecordMap">SELECT id,callback_no,provider_code,callback_type,business_id,idempotency_key,external_status,payload_json,process_status FROM callback_event WHERE idempotency_key=#{idempotencyKey}</select>
<update id="markProcessed">UPDATE callback_event SET process_status=#{processStatus},processed_at=#{processedAt,typeHandler=com.pk.infra.mybatis.typehandler.InstantTypeHandler} WHERE id=#{id}</update>
<update id="markIgnored">UPDATE callback_event SET process_status=#{processStatus},processed_at=#{processedAt,typeHandler=com.pk.infra.mybatis.typehandler.InstantTypeHandler} WHERE id=#{id}</update>
</mapper>
