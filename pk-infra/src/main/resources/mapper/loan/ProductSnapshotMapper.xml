<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pk.infra.loan.mapper.ProductSnapshotMapper">
<resultMap id="snapshotMap" type="com.pk.core.loan.port.ProductSnapshotRepository$ProductSnapshotRecord">
<constructor><arg column="id" javaType="_long"/><arg column="snapshot_no" javaType="string"/>
<arg column="apply_id" javaType="string"/><arg column="credit_application_id" javaType="_long"/>
<arg column="credit_status" javaType="string"/><arg column="product_status" javaType="string"/>
<arg column="products_json" javaType="string"/>
<arg column="fetched_at" javaType="java.time.Instant" typeHandler="com.pk.infra.mybatis.typehandler.InstantTypeHandler"/></constructor></resultMap>
<insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">INSERT INTO pk_product_snapshot
(snapshot_no,apply_id,credit_application_id,credit_status,product_status,products_json,fetched_at)
VALUES (#{snapshotNo},#{applyId},#{creditApplicationId},#{creditStatus},#{productStatus},#{productsJson},#{fetchedAt,typeHandler=com.pk.infra.mybatis.typehandler.InstantTypeHandler})</insert>
<select id="findBySnapshotNo" resultMap="snapshotMap">SELECT id,snapshot_no,apply_id,credit_application_id,credit_status,product_status,products_json,fetched_at
FROM pk_product_snapshot WHERE snapshot_no=#{snapshotNo}</select>
<select id="findLatestByCreditApplicationId" resultMap="snapshotMap">SELECT id,snapshot_no,apply_id,credit_application_id,credit_status,product_status,products_json,fetched_at
FROM pk_product_snapshot WHERE credit_application_id=#{creditApplicationId} ORDER BY fetched_at DESC,id DESC LIMIT 1</select>
</mapper>
